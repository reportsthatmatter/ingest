<text top="809" left="452" width="33" height="14" font="8"><i>, p24;  </i></text>
<text top="824" left="174" width="63" height="14" font="8"><i>Bloomfield, </i></text>
<text top="824" left="237" width="95" height="14" font="9"><i>Stormont in Crisis</i></text>
