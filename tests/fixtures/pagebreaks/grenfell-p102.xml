<text top="1101" left="85" width="15" height="11" font="8">470 </text>
<text top="1101" left="106" width="177" height="18" font="9">{CTAR00000019/4} section 3.</text>
<text top="1117" left="85" width="15" height="11" font="8">471 </text>
<text top="1116" left="106" width="126" height="18" font="9">{CTAR00000019/10}.</text>
<text top="1133" left="85" width="15" height="11" font="8">472 </text>
<text top="1132" left="106" width="182" height="18" font="9">{CTAR00000019/4} clause 1.2.</text>
<text top="1149" left="85" width="15" height="11" font="8">473 </text>
<text top="1148" left="106" width="350" height="18" font="9">{CLG00019478/2} for a list of members of the Committee.</text>
<text top="1164" left="85" width="15" height="11" font="8">474 </text>
