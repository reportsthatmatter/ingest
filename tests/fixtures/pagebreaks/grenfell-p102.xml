<text top="1054" left="85" width="16" height="11" font="8">467 </text>
<text top="1053" left="106" width="98" height="18" font="9">{BRE00005868}.</text>
<text top="1070" left="85" width="16" height="11" font="8">468 </text>
<text top="1069" left="106" width="169" height="18" font="9">Colwell {Day231/198:13-16}.</text>
<text top="1086" left="85" width="16" height="11" font="8">469 </text>
