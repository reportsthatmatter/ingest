<text top="880" left="106" width="150" height="18" font="9">paragraphs 264 and 266.</text>
<text top="897" left="85" width="15" height="11" font="8">457 </text>
<text top="896" left="106" width="167" height="18" font="9">Martin {Day250/102:10-14}.</text>
